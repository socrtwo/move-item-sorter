# =============================================================================
# Move Item Sorter — .gitignore
# Covers: Flutter/Dart, Android, iOS, macOS, Windows, Linux, Web
# =============================================================================

# -----------------------------------------------------------------------------
# Flutter / Dart
# -----------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
pubspec.lock          # keep if you want reproducible CI builds; remove to ignore
build/
.pub-cache/
.pub/
**/doc/api/
.dart_tool/flutter_gen/

# Generated source files (build_runner)
**/*.g.dart
**/*.freezed.dart
**/*.mocks.dart

# Coverage
coverage/
*.lcov

# -----------------------------------------------------------------------------
# Android
# -----------------------------------------------------------------------------
.gradle/
**/android/**/gradle-wrapper.jar
**/android/.gradle
**/android/captures/
**/android/gradlew
**/android/gradlew.bat
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/android/key.properties
**/*.jks
**/*.keystore

# APK / AAB outputs
*.apk
*.aab
output-metadata.json

# Android Studio / IntelliJ
.idea/
*.iml
.externalNativeBuild/
.cxx/
captures/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Google Services (API keys — NEVER commit)
google-services.json

# Android Profiling
*.hprof

# -----------------------------------------------------------------------------
# iOS / iPadOS
# -----------------------------------------------------------------------------
**/ios/**/*.mode1v3
**/ios/**/*.mode2v3
**/ios/**/*.moved-aside
**/ios/**/*.pbxuser
**/ios/**/*.perspectivev3
**/ios/**/*sync/
**/ios/**/.sconsign.dblite
**/ios/**/.tags*
**/ios/**/.vagrant/
**/ios/**/DerivedData/
**/ios/**/Icon?
**/ios/**/Pods/
**/ios/**/.symlinks/
**/ios/**/profile
**/ios/**/xcuserdata
**/ios/.generated/
**/ios/Flutter/.last_build_id
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/ephemeral/
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip
**/ios/Flutter/flutter_assets/
**/ios/Flutter/flutter_export_environment.sh
**/ios/ServiceDefinitions.json
**/ios/Runner/GeneratedPluginRegistrant.*

# CocoaPods
**/ios/Podfile.lock

# Xcode
*.xccheckout
*.xcscmblueprint

# iOS signing (NEVER commit provisioning profiles or certificates)
*.mobileprovision
*.p12
*.cer
*.certSigningRequest

# -----------------------------------------------------------------------------
# macOS
# -----------------------------------------------------------------------------
**/macos/**/DerivedData/
**/macos/**/Pods/
**/macos/**/.symlinks/
**/macos/**/xcuserdata/
**/macos/Flutter/GeneratedPluginRegistrant.swift
**/macos/Flutter/ephemeral/
**/macos/Podfile.lock

# macOS system files
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# -----------------------------------------------------------------------------
# Windows
# -----------------------------------------------------------------------------
**/windows/**/flutter/generated_plugin_registrant.cc
**/windows/**/flutter/generated_plugin_registrant.h
**/windows/**/flutter/generated_plugins.cmake

# Visual Studio
.vs/
*.user
*.suo
*.sln.docstates
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
*.VC.db
*.VC.opendb
*.vcxproj.user
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
install_manifest.txt

# Windows system files
Thumbs.db
Thumbs.db:encdata
Desktop.ini
$RECYCLE.BIN/
*.lnk

# -----------------------------------------------------------------------------
# Linux
# -----------------------------------------------------------------------------
**/linux/**/flutter/generated_plugin_registrant.cc
**/linux/**/flutter/generated_plugin_registrant.h
**/linux/**/flutter/generated_plugins.cmake
CMakeFiles/
CMakeCache.txt
cmake_install.cmake

# Linux system
*~
.nfs*

# -----------------------------------------------------------------------------
# Web
# -----------------------------------------------------------------------------
**/web/**/flutter_service_worker.js
.dart_tool/flutter_gen/

# Node / npm (tooling)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp/
.pnp.js

# -----------------------------------------------------------------------------
# Logs & OS
# -----------------------------------------------------------------------------
*.log
logs/
*.tmp
*.temp
*.bak
*.swp
*.swo
*.orig

# -----------------------------------------------------------------------------
# Secrets — NEVER commit these
# -----------------------------------------------------------------------------
.env
.env.*
*.env
secrets.dart
google-services.json
GoogleService-Info.plist
firebase_options.dart
local.properties
**/android/key.properties
**/*.p8

# -----------------------------------------------------------------------------
# IDE / Editor
# -----------------------------------------------------------------------------
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
# Keep .vscode/extensions.json (shared recommended extensions)
!.vscode/extensions.json

# JetBrains (IntelliJ / Android Studio / Fleet)
.idea/
*.iml
*.iws
*.ipr
out/
.fleet/

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
.\#*
.emacs.desktop
.emacs.desktop.lock

# -----------------------------------------------------------------------------
# Generated / build artefacts
# -----------------------------------------------------------------------------
*.g.dart
*.freezed.dart
*.mocks.dart
*.pb.dart
*.pbenum.dart
*.pbserver.dart
*.pbjson.dart

# Exports generated at runtime (not source)
exports/
*.csv
*.xlsx
!scripts/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
.eggs/
.pytest_cache/
*.pyc
